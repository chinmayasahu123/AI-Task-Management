# Copy this file to .env and set strong, unique values before starting the stack.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_USER=tracklap
MYSQL_PASSWORD=replace-with-a-different-strong-password
MYSQL_DATABASE=task_management
MYSQL_CONNECTION_LIMIT=10
MYSQL_QUEUE_LIMIT=100
MYSQL_CONNECT_TIMEOUT_MS=10000
MYSQL_MAX_IDLE=10
MYSQL_IDLE_TIMEOUT_MS=60000
AUTH_RATE_LIMIT_MAX=10
CORS_ORIGIN=http://localhost:8080
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
